{
  "all": true,
  "include": ["src/**/*.js"],
  "exclude": ["src/test/**"],
  "extension": [".js"],
  "instrument": false,
  "sourceMap": false,
  "require": ["./test/unit/setup.cjs", "@babel/register"],
  "check-coverage": true,
  "per-file": true,
  "statements": 95,
  "branches": 95,
  "functions": 95,
  "lines": 95,
  "reporter": ["text", "html", "json"],
  "report-dir": "coverage"
}
